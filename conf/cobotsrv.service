[Unit]
Description=CoBotrix srv service
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/cobotsrv --config /etc/cobotrix/cobotsrv.toml
WorkingDirectory=/var/lib/cobotrix
StateDirectory=cobotrix
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
