# Public issuer of the identity provider (HTTPS in production).
ISSUER=https://id.example.com
# Confidential web client registered in the developer console.
CLIENT_ID=yufu-web-example
CLIENT_SECRET=replace-with-the-issued-secret
# Must match the registered redirect URI exactly.
REDIRECT_URI=http://127.0.0.1:3000/callback
POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000/
SCOPE=openid profile email
# Server-side session cookie signing secret (>= 32 characters).
SESSION_SECRET=replace-with-at-least-32-random-characters
# Reader credentials used only by this server for token introspection.
READER_CLIENT_ID=yufu-web-reader
READER_CLIENT_SECRET=replace-with-the-reader-secret
# Local HTTP is only accepted for loopback development.
ALLOW_INSECURE_LOOPBACK=false
PORT=3000
