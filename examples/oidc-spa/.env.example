# Browser-visible configuration. Vite only exposes VITE_* variables.
# Never add a client secret or reader credential with a VITE_ prefix.
VITE_ISSUER=https://id.example.com
VITE_CLIENT_ID=yufu-spa-example
VITE_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/
VITE_SCOPE=openid profile email
VITE_API_BASE_URL=http://127.0.0.1:3001

# Server-only configuration for the companion protected API process.
# These values are read by server/config.ts and never reach the browser bundle.
API_AUDIENCE=urn:app:production
SPA_CLIENT_ID=yufu-spa-example
READER_CLIENT_ID=yufu-spa-reader
READER_CLIENT_SECRET=replace-with-the-reader-secret
ALLOWED_ORIGIN=http://127.0.0.1:5173
ALLOW_INSECURE_LOOPBACK=false
PORT=3001
