# Development-only target for Vite's server-side /api proxy. This is not exposed
# to browser code and is not used by production builds.
IM_API_PROXY_TARGET=http://127.0.0.1:4000

# Public address of cobotusr's OIDC issuer.  Do not include a trailing slash.
VITE_OIDC_ISSUER=http://127.0.0.1:4000
VITE_OIDC_CLIENT_ID=cobotimx
VITE_OIDC_REDIRECT_URI=http://localhost:5174/oauth/callback

# IM API base URL.  The Vite development proxy forwards this path to cobotusr.
VITE_IM_API_BASE=/api/v1
