# 复制为 .env.local（本地开发）或 .env.production.local（生产构建）后按需修改。
# .env.local / .env.production.local 都已被 .gitignore 忽略。

# hash mode or html5 history mode, default html5
# VITE_ROUTER_HISTORY=html5 | hash

# system name, default web-template
VITE_SYSTEM_NAME=cobotsrv-template

# ---------------------------------------------------------------------------
# API 地址 (axios baseURL)
# ---------------------------------------------------------------------------
# 相对路径: 适用于"嵌入式单二进制"部署（cobotsrv 同源提供 SPA + API）、
#          Vite dev 模式（vite.config.ts 会把 /api/v1 代理到后端）、
#          以及前端独立部署但同域反代的场景。
# 推荐作为默认值。
VITE_BASE_URL=/api/v1

# 绝对 URL: 适用于"前后端分离 + 跨域"场景——前端托管在 CDN/Nginx，
#          后端在另一个域名，需要 CORS 放行。
#          该值在 `vite build` 时固化，切换部署环境需要重新构建。
# VITE_BASE_URL=http://localhost:4000/api/v1

VITE_APP_TITLE=Cobotrix
