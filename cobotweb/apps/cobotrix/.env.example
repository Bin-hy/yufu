# cobotsrv 地址 — 既是 OIDC IdP 也是 /mgmt/* 反向代理入口
VITE_COBOTSRV_URL=http://localhost:4000

# OIDC client 配置（与 cobotsrv 的 [[oidc.bootstrap_clients]] 对应）
VITE_OIDC_CLIENT_ID=cobotrix
# Public clients running PKCE 理论上不需要 secret，但 cobotsrv 当前的 token endpoint
# 仍会校验。dev 环境从 conf/cobotnil/cobotsrv.toml 拷过来即可。
VITE_OIDC_CLIENT_SECRET=dev-cobotrix-secret-change-me
# 默认 = `${window.location.origin}/oauth/callback`，本地一般不用改
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/oauth/callback
