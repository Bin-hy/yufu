# cobotsrv OIDC IdP 地址 — authorize / token / JWKS
VITE_COBOTSRV_URL=http://localhost:4000

# cobotrix 后端地址 — 业务 API (devices / tasks / remote)
VITE_COBOTRIX_URL=http://localhost:4001

# cobotusr 管理端 SPA 地址 — 「接入与访问」页的权限管理跳转链接
# （默认回退到 VITE_COBOTSRV_URL）
VITE_COBOTUSR_WEB_URL=http://localhost:4000

# OIDC client 配置（与 cobotsrv 的 [[oidc.bootstrap_clients]] 对应）
VITE_OIDC_CLIENT_ID=cobotrix
# refresh_token grant 需要 client_secret，从 conf/cobotnil/cobotsrv.toml 拷过来
VITE_OIDC_CLIENT_SECRET=dev-cobotrix-secret-change-me
# 默认 = `${window.location.origin}/oauth/callback`，本地一般不用改
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/oauth/callback
