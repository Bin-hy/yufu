# Copy to .env in this directory and replace every CHANGE_ME value.
# `docker compose` reads this file for variable substitution.
# Never commit the filled-in .env (it is git-ignored).

# Public host name served by Caddy. Use a real DNS name in production and
# `localhost` for a local trial. The service config's issuer and origins must be
# https://<YUFU_DOMAIN>[:<YUFU_HTTPS_PORT>].
YUFU_DOMAIN=CHANGE_ME.example.com
# Publish 443/80 in production; use e.g. 8443/8080 when something else owns them.
YUFU_HTTPS_PORT=443
YUFU_HTTP_PORT=80

# PostgreSQL credentials. Use a long random password; percent-encode characters
# that are special in a URL (for example @ : / ? # % &).
POSTGRES_USER=yufu
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=yufu

# Secret used for CSRF and session material. Generate with: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_generate_a_long_random_value

# Log verbosity: off, error, warn, info, debug, trace.
LOG_LEVEL=info

# Image tag produced by `docker compose build`.
YUFU_IMAGE=yufu:local
