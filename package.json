{
  "name": "cobotrix",
  "private": true,
  "version": "1.0.0",
  "description": "Authentication center (Rust + Vue) with standard OIDC examples",
  "scripts": {
    "dev:cobotusr": "pnpm --filter @cobotweb/cobotusr dev",
    "build:cobotusr": "pnpm --filter @cobotweb/cobotusr build",
    "build": "pnpm build:cobotusr",
    "check:examples": "pnpm --filter './examples/*' check",
    "test:examples": "pnpm --filter './examples/*' test",
    "build:examples": "pnpm --filter './examples/*' build"
  }
}
