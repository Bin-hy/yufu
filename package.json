{
  "name": "yufu",
  "private": true,
  "version": "1.0.0",
  "description": "Authentication center (Rust + Vue) with standard OIDC examples",
  "scripts": {
    "dev:web": "pnpm --filter @yufu/web dev",
    "dev:website": "pnpm --filter @yufu/website dev",
    "build:web": "pnpm --filter @yufu/web build",
    "build:website": "pnpm --filter @yufu/website build",
    "preview:website": "pnpm --filter @yufu/website preview",
    "check:website": "pnpm --filter @yufu/website check",
    "build": "pnpm build:web",
    "check:examples": "pnpm --filter './examples/*' check",
    "test:examples": "pnpm --filter './examples/*' test",
    "build:examples": "pnpm --filter './examples/*' build"
  }
}
